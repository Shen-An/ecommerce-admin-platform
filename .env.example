# 复制为 .env 后按需填写（切勿提交真实密钥）

# 通义千问 / DashScope
AI_DASHSCOPE_API_KEY=sk-xxx

# 可选：DeepSeek（OpenAI 兼容）
# AI_DEEPSEEK_API_KEY=sk-xxx
# AI_DEEPSEEK_BASE_URL=https://api.deepseek.com

# LightRAG
LIGHTRAG_BASE_URL=http://localhost:9621
# LIGHTRAG_API_KEY=

# MinIO
MINIO_ENDPOINT=http://localhost:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-knowledge

# 本地中间件（与 docker-compose 一致）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
REDIS_HOST=localhost
REDIS_PORT=6379
# 本机 Redis 无密码时保持为空
REDIS_PASSWORD=
NACOS_ADDR=http://localhost:8848

# ---- LightRAG / NVIDIA Embedding（Phase 2）----
# 计划使用英伟达 Embedding（NIM 或本地 NVIDIA 模型 OpenAI-compatible 接口）
# EMBEDDING_BINDING=openai
# EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
# EMBEDDING_DIM=1024
# EMBEDDING_BINDING_HOST=https://integrate.api.nvidia.com/v1
# NVIDIA_API_KEY=nvapi-xxx
