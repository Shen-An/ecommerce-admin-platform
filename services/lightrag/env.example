# LightRAG 环境变量示例
# 复制为同目录 .env 后填写真实密钥（勿提交 .env）

HOST=0.0.0.0
PORT=9621
WORKING_DIR=./rag_storage
INPUT_DIR=./inputs

# ---- Chat LLM（国内 OpenAI 兼容）----
LLM_BINDING=openai
LLM_MODEL=qwen-plus
LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BINDING_API_KEY=sk-your-dashscope-key

# DeepSeek 示例：
# LLM_MODEL=deepseek-chat
# LLM_BINDING_HOST=https://api.deepseek.com
# LLM_BINDING_API_KEY=sk-your-deepseek-key

# ---- Embedding = NVIDIA（Phase2 推荐）----
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
EMBEDDING_DIM=2048
EMBEDDING_BINDING_HOST=https://integrate.api.nvidia.com/v1
EMBEDDING_BINDING_API_KEY=nvapi-your-nvidia-key

# 兼容部分脚本
# NVIDIA_API_KEY=nvapi-your-nvidia-key
# OPENAI_API_KEY=  # 勿与 LLM key 混用；以 LightRAG 文档为准

# 可选鉴权
# LIGHTRAG_API_KEY=
